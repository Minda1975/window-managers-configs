###############################################################################
# Functions
###############################################################################
AddToFunc StartFunction
+ I Module FvwmAuto 200 Raise Nop
+ I Module FvwmAnimate
+ I Module FvwmPager
+ I Exec xclock -geometry 47x47-0+0 -bg Snow -fg black &
#+ I Exec Esetroot -s $[HOME]/.fvwm/picture/churchwllpper.jpg &
#+ I Exec xsetroot -solid grey20
